# Copy this file to ".env.local" for local runs, or add the same keys in
# Vercel → Project → Settings → Environment Variables. All keys are read
# on the server only; nothing here is ever sent to the browser.

# Signs login tokens. Use any long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Chat assistant provider: local | gemini | grok
# "local" (default) answers from the built-in portal guide — no key needed.
CHAT_PROVIDER=local

# Google Gemini (free key: https://aistudio.google.com → Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# xAI Grok (key: https://console.x.ai → API Keys)
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# ---------------------------------------------------------------------------
# ASTRA V2 needs no additional environment variables. The delta cache, the
# device (MAC) evidence, the camera scan, the Hindi interface and the
# responsive layer all run from the seeded dataset and the browser.
#
# Optional, and only if you want the assistant to use a hosted model:
#   CHAT_PROVIDER=gemini|grok plus the matching key above.
# Leave CHAT_PROVIDER unset for the zero-config local guide, which is
# bilingual and needs no key.
# ---------------------------------------------------------------------------
