# Copy this file to ".env.local" for local runs, or add the same keys in
# Vercel → Project → Settings → Environment Variables. All keys are read
# on the server only; nothing here is ever sent to the browser.

# Signs login tokens. Use any long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Chat assistant provider: local | gemini | grok
# "local" (default) answers from the built-in portal guide — no key needed.
CHAT_PROVIDER=local

# Google Gemini (free key: https://aistudio.google.com → Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# xAI Grok (key: https://console.x.ai → API Keys)
XAI_API_KEY=
XAI_MODEL=grok-3-mini
